{
  "manifest_version": 3,
  "name": "To reMarkable",
  "version": "0.1.0",
  "description": "Send the current Google Doc, PDF, or web article to your reMarkable tablet as a PDF sized for its screen.",
  "browser_specific_settings": {
    "gecko": {
      "id": "to-rm-stack@mohoromitch",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["scripting", "storage", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "page": "background/background.html"
  },
  "action": {
    "default_title": "Send to reMarkable",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Open the Send to reMarkable popup"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon-96.png"
  }
}
